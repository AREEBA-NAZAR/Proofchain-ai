# Copy to .env. Every value is optional; defaults run the local prototype.

# DATABASE_URL=postgresql+psycopg2://proofchain:proofchain@localhost:5432/proofchain
# IPFS_API_URL=http://127.0.0.1:5001

# Sepolia: point at your RPC provider and the deployment file written by
# `npx hardhat run scripts/deploy.js --network sepolia`
# RPC_URL=https://sepolia.infura.io/v3/<key>
# DEPLOYMENT_FILE=../contracts/deployments/sepolia.json

# PUBLIC_APP_URL=http://localhost:3000
# CORS_ORIGINS=http://localhost:3000
# MAX_UPLOAD_MB=50
