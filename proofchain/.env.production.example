# Copy this file to .env. Never commit .env or contracts/.env.
PUBLIC_DOMAIN=proofchain.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
RPC_URL=https://sepolia.example-rpc-provider.invalid/YOUR_KEY
PUBLIC_APP_URL=https://proofchain.example.com
CORS_ORIGINS=https://proofchain.example.com
NEXT_PUBLIC_API_URL=
API_RATE_LIMIT_PER_MINUTE=120
UPLOAD_RATE_LIMIT_PER_MINUTE=20
INDEXER_ENABLED=true
INDEXER_POLL_SECONDS=10
INDEXER_CONFIRMATIONS=3
WALLET_AUTH_REQUIRED=true
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
